{
  "packages": [
    {
      "path": "modules/operatoraccountdirectory",
      "owner": "operator-account-directory",
      "role": "compose",
      "internal_test_role": "module-internal-test",
      "external_test_role": "module-behavior-test"
    },
    {
      "path": "modules/operatoraccountdirectory/contract",
      "owner": "operator-account-directory",
      "role": "public",
      "internal_test_role": "module-internal-test",
      "external_test_role": "module-behavior-test"
    },
    {
      "path": "modules/operatoraccountdirectory/internal/postgres",
      "owner": "operator-account-directory",
      "role": "postgres",
      "internal_test_role": "module-internal-test",
      "external_test_role": "workflow-integration-test"
    }
  ],
  "rules": [
    {
      "id": "operator-account-directory.postgres.contract",
      "description": "The operator account directory answers in its own read-only values (ADR 0324).",
      "scopes": [
        "production"
      ],
      "source_owner": "operator-account-directory",
      "source_role": "postgres",
      "target_owner": "operator-account-directory",
      "target_role": "public"
    }
  ],
  "read_projections": [
    {
      "id": "operator-account-pages",
      "package": "modules/operatoraccountdirectory/internal/postgres",
      "data_objects": [
        "auth.account_roles",
        "auth.account_tenants",
        "auth.accounts",
        "auth.invitation_tokens",
        "auth.roles",
        "platform.schools",
        "users.persons",
        "users.staff_school_memberships",
        "users.teachers"
      ],
      "tenant_safe": true
    }
  ]
}
